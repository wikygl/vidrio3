rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {

      // ===== Helpers generales =====
      function isSignedIn() {
        return request.auth != null;
      }

      // Panel: crystalAdmin (admin / operador)
      function isPanelRole() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.role in ["admin","operador"];
      }

      function isAdmin() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.role == "admin";
      }

      // CrystalServer (nodos capturadores) — USA SOLO admin_roles
      function isServerRole() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.role == "server";
      }

      // Usuario dueño de un recurso
      function isOwner(uid) {
        return isSignedIn() && request.auth.uid == uid;
      }

      // Custom claim `patronUid`: una TERMINAL autorizada lo lleva para actuar como su patrón en el
      // chat (lo asigna la Cloud Function asignarClaimPatron). Devuelve '' si no lo tiene.
      function claimPatron() {
        return request.auth != null && 'patronUid' in request.auth.token
          ? request.auth.token.patronUid : '';
      }

      // Modo desarrollo (bandera opcional en Firestore)
      function isDevMode() {
        return exists(/databases/$(database)/documents/config/flags)
          && (get(/databases/$(database)/documents/config/flags).data.devMode == true);
      }

      // === Helpers específicos para usuarios/{uid} ===

      // Campos "de valor": crean dinero o regalan servicio. Se aíslan para poder exigirles un
      // permiso más alto que al resto del perfil.
      function tocaValor() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny(['wallet','wallet_saldo_cent','estado_servicio']);
      }

      // Canal MANUAL de crystalAdmin: cuando el circuito automático (Cloud Functions) está caído,
      // un `admin` corrige el saldo o el estado a mano desde el panel. Es la vía de emergencia, así
      // que se restringe al rol `admin` — un `operador` puede editar el resto del perfil, pero
      // nunca acreditar saldo ni otorgar FULL. Todo ajuste deja rastro en wallet_movs.
      function isPanelSafeUpdate() {
        return isPanelRole() && !tocaValor();
      }

      function isOwnerProfileUpdate(uid) {
        return isOwner(uid)
          && !(
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasAny(['wallet','wallet_saldo_cent','estado_servicio'])
          );
      }

      // El cliente NUNCA activa un plan de pago por su cuenta: comprar FULL va por la Cloud
      // Function `activarPlan` (admin SDK, ignora estas reglas). El cliente solo puede hacer dos
      // cambios seguros sobre estado_servicio, y sin tocar el saldo/wallet:

      // 1) Bajar a BASIC (recálculo al vencer). No otorga nada, así que siempre es seguro.
      function isOwnerServiceDowngrade(uid) {
        return isOwner(uid)
          && !(
            request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['wallet','wallet_saldo_cent'])
          )
          && request.resource.data.estado_servicio.mode == 'BASIC';
      }

      // 2) Crear el trial inicial gratis: SOLO si antes no existía estado_servicio (una sola vez),
      //    con mode FULL de origen TRIAL_1M y un vencimiento ACOTADO por el reloj del servidor
      //    (máx. ~32 días). Impide el hueco de "FULL para siempre" y que se repita el trial.
      function isOwnerTrialCreation(uid) {
        return isOwner(uid)
          && !('estado_servicio' in resource.data)
          && !(
            request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['wallet','wallet_saldo_cent'])
          )
          && request.resource.data.estado_servicio.mode == 'FULL'
          && request.resource.data.estado_servicio.source == 'TRIAL_1M'
          && request.resource.data.estado_servicio.full_until is timestamp
          && request.resource.data.estado_servicio.full_until < request.time + duration.value(32, 'd');
      }

      // ===== config =====
      match /config/{docId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      // ===== Roles (admin_roles) =====
      match /admin_roles/{uid} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }

      // ===== Usuarios =====
      match /usuarios/{uid} {
        allow read: if isSignedIn() || isOwner(uid) || isPanelRole();
        allow create: if isOwner(uid) || isPanelRole();
        allow update: if
          isAdmin()                  // ajuste manual: saldo y estado_servicio incluidos
          || isPanelSafeUpdate()     // operador: el resto del perfil, nunca saldo ni estado
          || isOwnerProfileUpdate(uid)
          || isOwnerServiceDowngrade(uid)
          || isOwnerTrialCreation(uid);
        allow delete: if isAdmin();

        match /dispositivos/{deviceId} {
          allow read, write: if isOwner(uid) || isPanelRole();
        }

        // ===== Libro de movimientos del wallet =====
        // Lo escribe normalmente el Admin SDK, que ignora estas reglas; por eso nunca hubo regla y
        // la LECTURA quedaba denegada por defecto (la lista de movimientos de crystalAdmin salía
        // vacía). Se abre al dueño y al panel. La CREACIÓN se limita al rol `admin` y exige el uid
        // de quien la hace: así un ajuste manual es siempre auditable. Nadie edita ni borra.
        match /wallet_movs/{movId} {
          allow read: if isOwner(uid) || isPanelRole();
          allow create: if isAdmin()
            && request.resource.data.tipo is string
            && request.resource.data.monto_cent is number
            && request.resource.data.adminUid == request.auth.uid;
          allow update, delete: if false;
        }

        match /security {
          match /pin_reset {
            allow read: if isOwner(uid) || isPanelRole();
            allow write: if false;
          }

          match /walletPin {
            allow read: if isOwner(uid) || isPanelRole();
            allow create, update: if isOwner(uid) || isPanelRole();
            allow delete: if isAdmin();
          }

          match /wallet_state {
            allow read: if isOwner(uid) || isPanelRole();
            allow create, update: if isOwner(uid) || isPanelRole();
            allow delete: if isAdmin();
          }

          match /{secDocId} {
            allow read: if isOwner(uid) || isPanelRole();
            allow create: if (
                isOwner(uid) && secDocId.matches("^walletPin_audit_.*$")
              ) || isPanelRole();
            allow update, delete: if isPanelRole();
          }
        }

        // Subcolecciones de usuarios
        match /{sub=**}/{doc} {
          allow read: if isSignedIn() || isOwner(uid) || isPanelRole();
          allow write: if isOwner(uid) || isPanelRole();
        }
      }

      // ===== Vouchers (legacy) =====
      match /vouchers/{voucherId} {
        allow read: if isPanelRole()
          || (isSignedIn() && resource != null && resource.data.uid == request.auth.uid);
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.estado == "pendiente";
        allow update: if isPanelRole() || isServerRole();
        allow delete: if isAdmin();
      }

      // ===== Depósitos confirmados =====
      match /depositos_confirmados/{codigo} {
        allow read: if isPanelRole()
          || (isSignedIn()
              && resource != null
              && "uid" in resource.data
              && resource.data.uid == request.auth.uid);
        // Solo CrystalServer (rol server) o el panel pueden confirmar un depósito. El usuario NO
        // puede crearlo: así el pago solo se marca cuando el servidor detectó dinero real.
        allow create, update: if isPanelRole() || isServerRole();
        allow delete: if isAdmin();
      }

      // ===== CrystalServer: notificaciones Yape / PLIN =====
      match /notificaciones_servidor/{deviceId} {
        allow read: if isPanelRole() || isServerRole();
        allow write: if isServerRole() || isPanelRole();

        match /registros/{regId} {
          allow read: if isPanelRole();
          allow create, update, delete: if isServerRole() || isPanelRole();
        }

        match /ocurrencias/{occId} {
          allow read: if isPanelRole();
          allow create, update, delete: if isServerRole() || isPanelRole();
        }
      }

      // ⭐ NUEVA REGLA: Permitir collectionGroup para "registros"
      match /{path=**}/registros/{regId} {
        allow read: if isPanelRole();
      }

      // Permitir collectionGroup para "ocurrencias" (crystalAdmin las lista globalmente)
      match /{path=**}/ocurrencias/{occId} {
        allow read: if isPanelRole();
      }

      // Permitir collectionGroup para "recargas" (el panel puede listar recargas de usuarios)
      match /{path=**}/recargas/{recId} {
        allow read: if isPanelRole();
      }

      // ===== COMPROBANTES ELECTRÓNICOS (boletas SUNAT) =====
      // Los escribe SOLO el Admin SDK, que ignora estas reglas; por eso todo `write` es false.
      // El usuario puede leer los suyos para descargar su boleta; el consolidado diario no tiene
      // dueño (agrupa operaciones de varios) y queda reservado al panel.
      match /comprobantes/{comprobanteId} {
        allow read: if isPanelRole()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
        allow write: if false;
      }

      match /consolidado_diario/{fecha} {
        allow read: if isPanelRole();
        allow write: if false;
        match /items/{itemId} {
          allow read: if isPanelRole();
          allow write: if false;
        }
      }

      // Contador de correlativos. Nadie lo toca desde un cliente: un correlativo repetido o con
      // huecos es exactamente lo que SUNAT observa.
      match /series/{serie} {
        allow read: if isPanelRole();
        allow write: if false;
      }

      // ===== RECARGAS PENDIENTES =====
      match /recargas_pendientes/{recargaId} {
        allow read: if isPanelRole();
        allow create: if isPanelRole();
        allow update: if isPanelRole();
        allow delete: if isAdmin();
      }

      // ===== Reservas de recarga por monto único =====
      // El dueño solo LEE su reserva (para escuchar cuándo se acredita). Escriben solo las
      // Cloud Functions (admin), que crean la reserva y la marcan aplicada al llegar el pago.
      match /reservas_recarga/{reservaId} {
        allow read: if isPanelRole()
          || (isSignedIn() && resource != null && resource.data.uid == request.auth.uid);
        allow write: if isPanelRole();
      }

      // ===== Reclamos de recarga =====
      // El usuario afirma haber pagado un importe distinto al reservado (la costumbre de pagar
      // cantidades redondas). Los escribe y los resuelve SIEMPRE el servidor con el Admin SDK:
      // aquí no se permite ninguna escritura desde un cliente, porque el documento lleva el
      // resultado de la búsqueda del pago y el monto acreditado — dejar tocarlo sería dejar que
      // el reclamante se acredite a sí mismo.
      match /reclamos_recarga/{reclamoId} {
        allow read: if isPanelRole()
          || (isSignedIn() && resource != null && resource.data.uid == request.auth.uid);
        allow write: if false;
      }

      // ===== Tickets de soporte =====
      match /tickets/{ticketId} {
        function ownerUid() {
          return (resource != null && "ownerUid" in resource.data) ? resource.data.ownerUid
                 : (request.resource.data.ownerUid);
        }
        allow read: if isPanelRole() || (isSignedIn() && ownerUid() == request.auth.uid);
        allow create: if (isSignedIn() && request.resource.data.ownerUid == request.auth.uid) || isPanelRole();
        allow update: if isPanelRole() || (isSignedIn() && ownerUid() == request.auth.uid);
        allow delete: if isAdmin();

        match /mensajes/{msgId} {
          allow read: if isPanelRole()
            || (isSignedIn()
                && get(/databases/$(database)/documents/tickets/$(ticketId)).data.ownerUid == request.auth.uid);
          allow create: if isPanelRole()
            || (isSignedIn()
                && get(/databases/$(database)/documents/tickets/$(ticketId)).data.ownerUid == request.auth.uid);
          allow update, delete: if isAdmin();
        }
      }

      // ===== Salud de servidores =====
      match /servidores/{deviceId} {
        allow read: if isPanelRole();
        allow write: if isServerRole() || isPanelRole();
        allow delete: if isAdmin();
      }

      // ⭐⭐⭐ NUEVA REGLA 1: Permitir leer y marcar códigos temporales sin autenticación ⭐⭐⭐
      match /{path=**}/codigos_temporales/{codigoId} {
        allow read: if true;
        allow update: if request.resource.data.usado == true && resource.data.usado == false;
        allow create, delete: if false;
      }

      // ⭐⭐⭐ REGLA: Terminales pueden leer su propio documento ⭐⭐⭐
      match /{path=**}/autorizados/{deviceId} {
        allow read: if true;
        allow create: if
          request.resource.data.deviceId == deviceId
          && request.resource.data.rol == "TERMINAL"
          && request.resource.data.activo == true;
        allow update, delete: if false;
      }

      // Datos de negocio de una cuenta: los ve su dueño y las TERMINALES autorizadas de esa cuenta
      // (llevan el custom claim `patronUid`, que asigna asignarClaimPatron al arrancar).
      //
      // Antes estas rutas decían solo `isSignedIn()`, así que CUALQUIER usuario con sesión podía
      // leer la cartera de clientes y el catálogo de otro. Con pocos usuarios que se conocen no se
      // nota; con muchos es una fuga entre competidores.
      function esDeLaCuenta(uid) {
        return isOwner(uid) || claimPatron() == uid;
      }

      // ===== CLIENTES (Base de datos local + Firestore) =====
      match /usuarios/{uid}/clientes/{clienteId} {
        allow read: if esDeLaCuenta(uid);
        allow create: if esDeLaCuenta(uid)
          && request.resource.data.keys().hasAll([
            'id',
            'numeroDocumento',
            'nombreCompleto',
            'ultimaActualizacion'
          ])
          && request.resource.data.id is string
          && request.resource.data.numeroDocumento is string
          && request.resource.data.nombreCompleto is string
          && request.resource.data.ultimaActualizacion is number;
        allow update: if esDeLaCuenta(uid)
          && request.resource.data.id == resource.data.id
          && request.resource.data.numeroDocumento is string
          && request.resource.data.nombreCompleto is string
          && request.resource.data.ultimaActualizacion is number;
        allow delete: if esDeLaCuenta(uid);
      }

      // ===== PRODUCTOS (Base de datos local + Firestore) =====
      match /usuarios/{uid}/productos/{productoId} {
        // El precio se renombró a precioVenta (con precioCompra aparte), pero la regla seguía
        // exigiendo el campo viejo `precio`: con eso, crear un producto quedaba RECHAZADO y la
        // sincronización del catálogo no subía nada. Se acepta cualquiera de los dos nombres para
        // que los datos antiguos sigan siendo válidos.
        allow read: if esDeLaCuenta(uid);
        allow create: if esDeLaCuenta(uid)
          && request.resource.data.keys().hasAll([
            'id',
            'nombre',
            'categoria',
            'stock',
            'ultimaActualizacion'
          ])
          && request.resource.data.keys().hasAny(['precio', 'precioVenta'])
          && request.resource.data.id is string
          && request.resource.data.nombre is string
          && request.resource.data.categoria is string
          && request.resource.data.stock is number
          && request.resource.data.ultimaActualizacion is number;
        allow update: if esDeLaCuenta(uid)
          && request.resource.data.id == resource.data.id
          && request.resource.data.nombre is string
          && request.resource.data.stock is number
          && request.resource.data.ultimaActualizacion is number;
        allow delete: if esDeLaCuenta(uid);
      }

      // ===== CHATS (colección global) =====
      match /chats/{chatId} {
        function chatUsers() {
          return resource.data.users;
        }

        function isChatParticipant() {
          return isSignedIn() && (
            request.auth.uid in chatUsers() || claimPatron() in chatUsers()
          );
        }

        allow read: if isChatParticipant();

        allow create: if isSignedIn()
          && request.auth.uid in request.resource.data.users
          && request.resource.data.keys().hasAll(['id', 'name', 'users', 'lastMsgDate'])
          && request.resource.data.users is list
          && request.resource.data.users.size() == 2;

        allow update: if isChatParticipant()
          && request.resource.data.users == resource.data.users;

        allow delete: if isAdmin();

        match /messages/{msgId} {
          function chatUsersForMessage() {
            return get(/databases/$(database)/documents/chats/$(chatId)).data.users;
          }

          function isMessageParticipant() {
            return isSignedIn() && (
              request.auth.uid in chatUsersForMessage() || claimPatron() in chatUsersForMessage()
            );
          }

          function senderUid() {
            return resource.data.from;
          }

          function senderCanEditOwnMessage() {
            return isSignedIn()
              && (senderUid() == request.auth.uid || senderUid() == claimPatron());
          }

          function participantCanOnlyUpdateStatus() {
            return isMessageParticipant()
              && request.resource.data.from == resource.data.from
              && request.resource.data.fromUid == resource.data.fromUid
              && request.resource.data.id == resource.data.id
              && request.resource.data.dob == resource.data.dob
              && request.resource.data.message == resource.data.message
              && request.resource.data.tipo == resource.data.tipo
              && request.resource.data.type == resource.data.type
              && request.resource.data.nombreArchivo == resource.data.nombreArchivo
              && request.resource.data.fileName == resource.data.fileName
              && request.resource.data.schemaVersion == resource.data.schemaVersion
              && request.resource.data.sourceApp == resource.data.sourceApp
              && request.resource.data.targetApp == resource.data.targetApp
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'entregado',
                'leido'
              ]);
          }

          allow read: if isMessageParticipant();

          allow create: if isMessageParticipant()
            && (request.resource.data.from == request.auth.uid
                || request.resource.data.from == claimPatron());

          allow update: if senderCanEditOwnMessage() || participantCanOnlyUpdateStatus();

          allow delete: if isSignedIn()
            && (resource.data.from == request.auth.uid
                || resource.data.from == claimPatron()
                || isAdmin());
        }
      }

      // ===== TIENDA DE ANUNCIOS (docs/TIENDA_ANUNCIOS_PLAN.md) =====
      match /anuncios/{anuncioId} {
        // Una foto del anuncio, si la hay en la posición i, tiene que estar en la carpeta del
        // propio vendedor en nuestro Storage: así una edición no cuela imágenes de otro sitio.
        function fotoPropia(lista, i) {
          return lista.size() <= i
            || lista[i].matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/anuncios%2F'
                + request.auth.uid + '%2F' + anuncioId + '%2F.*');
        }

        function fotosPropias(lista) {
          return lista is list && lista.size() <= 5
            && fotoPropia(lista, 0) && fotoPropia(lista, 1) && fotoPropia(lista, 2)
            && fotoPropia(lista, 3) && fotoPropia(lista, 4);
        }

        // El dueño edita lo que escribió y pasa entre activo, pausado y retirado. El vencimiento,
        // lo pagado, las denuncias y salir de revisión o de vencido son del servidor y del panel.
        function esElDuenoEditando() {
          return isSignedIn()
            && resource.data.uid == request.auth.uid
            && resource.data.estado in ['activo', 'pausado', 'retirado']
            && request.resource.data.estado in ['activo', 'pausado', 'retirado']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'titulo', 'descripcion', 'precioCent', 'unidad', 'condicion', 'ciudad',
              'categoria', 'tipo', 'fotos', 'miniaturas', 'palabras', 'estado', 'editadoEn',
              'zonas'
            ])
            && (!('zonas' in request.resource.data)
              || (request.resource.data.zonas is list && request.resource.data.zonas.size() <= 5))
            && request.resource.data.titulo is string
            && request.resource.data.titulo.size() >= 4
            && request.resource.data.titulo.size() <= 80
            && request.resource.data.descripcion is string
            && request.resource.data.descripcion.size() <= 1500
            && request.resource.data.precioCent is int
            && request.resource.data.precioCent >= 0
            && fotosPropias(request.resource.data.fotos)
            && fotosPropias(request.resource.data.miniaturas)
            && request.resource.data.miniaturas.size() == request.resource.data.fotos.size()
            && request.resource.data.palabras is list
            && request.resource.data.palabras.size() <= 40;
        }

        // Quien abre un anuncio suma una vista, y nada más.
        function esUnaVistaMas() {
          return isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vistas'])
            && request.resource.data.vistas == resource.data.vistas + 1;
        }

        // Por ahora la tienda se ve solo desde Crystal, con sesión.
        allow read: if isSignedIn();
        // Publicar cobra del wallet: solo la función publicarAnuncio (admin SDK) crea anuncios.
        allow create: if false;
        allow update: if isAdmin() || esElDuenoEditando() || esUnaVistaMas();
        allow delete: if isAdmin();

        // Una denuncia por usuario (crear sobre una que ya existe es actualizar, y no se permite).
        // Las cuenta la función contarDenunciaAnuncio.
        match /denuncias/{uid} {
          allow create: if isOwner(uid)
            && get(/databases/$(database)/documents/anuncios/$(anuncioId)).data.uid != uid
            && request.resource.data.keys().hasOnly(['motivo', 'detalle', 'creadoEn'])
            && request.resource.data.motivo is string
            && request.resource.data.motivo.size() <= 60
            && request.resource.data.detalle is string
            && request.resource.data.detalle.size() <= 500;
          allow read: if isOwner(uid) || isPanelRole();
          allow update, delete: if isAdmin();
        }

        // Lo que decidió el panel sobre el anuncio (moderarAnuncio).
        match /moderacion/{movId} {
          allow read: if isPanelRole();
          allow write: if false;
        }
      }

      // ===== Vitrina de proveedores (fase 2) =====
      // La ficha la escribe solo el servidor (suscribirProveedor cobra; guardarProveedor arma las
      // claves de ciudad): así nadie se pone en todas las ciudades.
      match /proveedores/{uid} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // ===== Pedidos de clientes de la web (fase 3) =====
      // Los crea la función tiendaWeb. Lo público lo ve cualquier sesión; el contacto, nadie desde
      // la app: lo entrega tomarPedidoCliente y queda en tomas/{uid}, que solo lee quien lo tomó.
      match /pedidos_clientes/{pedidoId} {
        allow read: if isSignedIn();
        allow write: if false;

        match /privado/{doc} {
          allow read: if isPanelRole();
          allow write: if false;
        }
        match /tomas/{uid} {
          allow read: if isOwner(uid) || isPanelRole();
          allow write: if false;
        }
        match /reportes/{uid} {
          allow read: if isOwner(uid) || isPanelRole();
          allow write: if false;
        }
      }

      // Contadores de la web por IP y teléfono (en resumen, sin guardar el dato): solo el servidor.
      match /limites_web/{doc} {
        allow read, write: if false;
      }

      // ===== Regla catch-all (dev) =====
      match /{document=**} {
        allow read: if isDevMode() && isSignedIn();
        allow write: if isDevMode() && isPanelRole();
      }
    }
  }