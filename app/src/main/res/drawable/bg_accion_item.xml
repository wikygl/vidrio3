<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de acción del diálogo de un ítem de la lista: tarjeta blanca con borde suave. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E3F2FF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/blanco" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/panel_stroke" />
        </shape>
    </item>
</selector>
