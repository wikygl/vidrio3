<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de edición del ítem: caja gris clara que se marca en azul al escribir. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/blanco" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sombra" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/panel_stroke" />
        </shape>
    </item>
</selector>
