<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/color</item>
        <item name="colorPrimaryDark">@color/color</item>
        <item name="colorAccent">#0099FF</item>
    </style>
    <style name="nuevosplash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/nuevo</item>
    </style>
    <!-- Estilo para dialogo pantalla completa -->
    <style name="FullScreenDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/blanco</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <!--
      Celda de los paneles del apunte de medidas: el rótulo encima y el icono debajo, como en la
      barra de abajo. Los iconos sueltos y muy separados no se distinguían ni se acertaban.
    -->
    <style name="CeldaIconoMedida">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingStart">1dp</item>
        <item name="android:paddingEnd">1dp</item>
    </style>

    <style name="RotuloIconoMedida">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">#455A64</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="IconoMedida" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">2dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="DisenoNova.ControlButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:tint">@color/blanco</item>
        <item name="tint">@color/blanco</item>
    </style>

</resources>
