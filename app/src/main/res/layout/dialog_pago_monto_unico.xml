<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_full"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💳  Recarga tu saldo"
        android:textColor="#4527A0"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Paga EXACTAMENTE este monto:"
        android:textColor="#555555"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvMontoPago"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="S/ 0.00"
        android:textColor="#2979FF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNumeroPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="al número del negocio"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCopiarMonto"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_rounded"
        android:backgroundTint="@color/celeste"
        android:text="📋  Copiar monto"
        android:textAllCaps="false"
        android:textColor="@color/blanco"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Esos céntimos son tu código de recarga y se acreditan completos a tu saldo."
        android:textColor="#888888"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#E0E0E0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Después de pagar, adjunta el comprobante (obligatorio):"
        android:textColor="#555555"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSubirComprobante"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_rounded"
        android:backgroundTint="@color/verde"
        android:text="📤  Ya pagué — subir comprobante"
        android:textAllCaps="false"
        android:textColor="@color/blanco"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEstadoPago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="⏳  Esperando tu pago…"
        android:textColor="#F47D2E"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCerrarPago"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_rounded"
        android:backgroundTint="@color/gris"
        android:text="Cerrar"
        android:textAllCaps="false"
        android:textColor="@color/blanco" />

</LinearLayout>
