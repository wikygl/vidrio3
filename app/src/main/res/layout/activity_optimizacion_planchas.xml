<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".optimizadores.planchas.OptimizacionPlanchasActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:ignore="UselessParent">

            <!-- Cabecera igual a CorteActivity -->
            <LinearLayout
                android:id="@+id/lyCabeza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color"
                android:orientation="vertical"
                android:paddingStart="4.5dp"
                android:paddingTop="4.5dp"
                android:paddingEnd="4.5dp"
                android:paddingBottom="4.5dp"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.9"
                    tools:ignore="UselessParent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="0.8"
                        android:orientation="horizontal"
                        tools:ignore="DisableBaselineAlignment,NestedWeights">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textView2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="-6dp"
                                android:layout_weight="0.54"
                                android:gravity="center"
                                android:text="@string/crystal"
                                android:textAlignment="viewStart"
                                android:textColor="@color/blanco"
                                android:textSize="24sp"
                                tools:ignore="RtlCompat" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvIdVende"
                                    android:layout_width="wrap_content"
                                    android:layout_height="0dp"
                                    android:layout_gravity="end"
                                    android:layout_weight="1"
                                    android:text="Corte Planchas"
                                    android:textColor="@color/blanco"
                                    tools:ignore="TextContrastCheck" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/imageButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="1.8dp"
                        android:layout_weight="1"
                        android:background="@color/color"
                        android:contentDescription="@string/todo"
                        app:srcCompat="@drawable/ic_mensajes"
                        tools:ignore="TouchTargetSizeCheck,DuplicateSpeakableTextCheck" />

                    <ImageButton
                        android:id="@+id/taller_cal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/color"
                        android:contentDescription="@string/todo"
                        app:srcCompat="@drawable/ic_taller2"
                        tools:ignore="TouchTargetSizeCheck" />

                    <ImageButton
                        android:id="@+id/micro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="1.8dp"
                        android:layout_weight="1"
                        android:background="@color/color"
                        android:contentDescription="@string/todo"
                        app:srcCompat="@drawable/ic_clcv"
                        tools:ignore="TouchTargetSizeCheck" />

                    <ImageButton
                        android:id="@+id/imageButton9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="1.8dp"
                        android:layout_weight="1"
                        android:background="@color/color"
                        android:contentDescription="@string/todo"
                        app:srcCompat="@drawable/ic_usuario4"
                        tools:ignore="TouchTargetSizeCheck" />

                    <ImageButton
                        android:id="@+id/btScan"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="1.8dp"
                        android:layout_weight="1"
                        android:background="@color/color"
                        android:contentDescription="@string/todo"
                        app:srcCompat="@drawable/ic_hogar"
                        tools:ignore="TouchTargetSizeCheck" />

                    <ImageButton
                        android:id="@+id/btn_catalogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="1.8dp"
                        android:layout_weight="1"
                        android:background="@color/color"
                        android:contentDescription="@string/todo"
                        app:srcCompat="@drawable/ajustes_c"
                        tools:ignore="TouchTargetSizeCheck" />

                </LinearLayout>
            </LinearLayout>

            <!-- Cuerpo: col1 (listado) + col2 (planchas + formulario) -->
            <LinearLayout
                android:id="@+id/lyCuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Col 1: listado de medidas -->
                <LinearLayout
                    android:id="@+id/col1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="4.5dp"
                    android:layout_weight="1.27"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.27"
                        android:background="@drawable/corner"
                        android:orientation="vertical"
                        tools:ignore="NestedWeights,UselessParent">

                        <TextView
                            android:id="@+id/listado_txt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/corner2"
                            android:backgroundTint="@color/color"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/listado_de_medidas"
                            android:textColor="@color/blanco"
                            tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />

                        <Spinner
                            android:id="@+id/spCortes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/cornere" />

                        <ListView
                            android:id="@+id/listCorte"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            tools:ignore="TooManyViews" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Col 2: planchas disponibles + formulario -->
                <LinearLayout
                    android:id="@+id/col2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4.5dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/corner"
                    android:orientation="vertical"
                    tools:ignore="NestedWeights">

                    <!-- Header planchas disponibles: "Planchas y retazos" -->
                    <TextView
                        android:id="@+id/textV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/corner2"
                        android:backgroundTint="@color/color"
                        android:gravity="center"
                        android:text="Planchas y retazos"
                        android:textColor="@color/blanco"
                        tools:ignore="TextContrastCheck" />

                    <LinearLayout
                        android:id="@+id/lyLits"
                        android:layout_width="match_parent"
                        android:layout_height="117dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Lista de planchas disponibles -->
                        <ListView
                            android:id="@+id/listaPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Agregar / Eliminar plancha -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="-1dp"
                                android:layout_weight="2"
                                android:background="@drawable/cornere"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/btAgregar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:srcCompat="@drawable/agregar"
                                    tools:ignore="ContentDescription,ImageContrastCheck" />

                                <ImageView
                                    android:id="@+id/btEliminar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:srcCompat="@drawable/eliminar"
                                    tools:ignore="ContentDescription" />

                            </LinearLayout>

                            <!-- Nivel de optimización -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="-1dp"
                                android:layout_marginBottom="-1dp"
                                android:layout_weight="1"
                                android:background="@drawable/cornere"
                                android:orientation="vertical"
                                android:paddingStart="1dp"
                                tools:ignore="RtlSymmetry">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Nivel" />

                                <SeekBar
                                    android:id="@+id/sbNivel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:max="2"
                                    android:progress="1"
                                    tools:ignore="TouchTargetSizeCheck" />

                                <TextView
                                    android:id="@+id/tvNivel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:minWidth="50dp"
                                    android:text="Normal" />

                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Cabecera "Medidas y cantidades" con toggle modo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/cornere"
                            android:backgroundTint="@color/color"
                            android:gravity="center"
                            android:text="@string/medidas_y_cantidades"
                            android:textColor="@color/blanco"
                            tools:ignore="TextContrastCheck" />

                        <!-- Espesor de disco -->
                        <TextView
                            android:id="@+id/tbDisco"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/botoncircular"
                            android:backgroundTint="@color/celeste"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="0.0"
                            android:textColor="@color/blanco"
                            android:textSize="11sp"
                            tools:ignore="SmallSp,TouchTargetSizeCheck,TextContrastCheck" />
                    </LinearLayout>

                    <!-- Formulario de entrada (160dp para caber los 4 campos) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="3dp"
                        android:orientation="vertical"
                        tools:ignore="UselessParent">

                        <!-- Ancho -->
                        <LinearLayout
                            android:id="@+id/med1_lay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvLabelAncho"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:layout_weight="1"
                                android:background="@drawable/botoncircular"
                                android:paddingStart="6dp"
                                android:text="Ancho"
                                tools:ignore="RtlSymmetry" />

                            <EditText
                                android:id="@+id/etMedida"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:autofillHints="@string/todo"
                                android:backgroundTint="@color/color"
                                android:ems="10"
                                android:inputType="numberDecimal"
                                android:textColorHint="@color/sombra2"
                                android:textColorLink="@color/color"
                                tools:ignore="LabelFor,TouchTargetSizeCheck,SpeakableTextPresentCheck" />
                        </LinearLayout>

                        <!-- Alto (visible solo en modo vidrio) -->
                        <LinearLayout
                            android:id="@+id/lyAlto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:layout_weight="1"
                                android:background="@drawable/botoncircular"
                                android:paddingStart="6dp"
                                android:text="Alto"
                                tools:ignore="RtlSymmetry" />

                            <EditText
                                android:id="@+id/etAlto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:autofillHints="@string/todo"
                                android:backgroundTint="@color/celeste"
                                android:ems="10"
                                android:inputType="numberDecimal"
                                android:textColorHint="@color/sombra2"
                                tools:ignore="LabelFor,TouchTargetSizeCheck,SpeakableTextPresentCheck" />
                        </LinearLayout>

                        <!-- Cantidad -->
                        <LinearLayout
                            android:id="@+id/cant_lay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textView5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:layout_weight="1"
                                android:background="@drawable/botoncircular"
                                android:paddingStart="6dp"
                                android:text="@string/cantidad"
                                tools:ignore="RtlSymmetry" />

                            <EditText
                                android:id="@+id/etCant"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:autofillHints="@string/todo"
                                android:backgroundTint="@color/color"
                                android:ems="10"
                                android:inputType="number"
                                android:textColorHint="@color/sombra2"
                                tools:ignore="LabelFor,TouchTargetSizeCheck,SpeakableTextPresentCheck" />
                        </LinearLayout>

                        <!-- Referencia / Info -->
                        <LinearLayout
                            android:id="@+id/precio_lay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvLabelRef"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:layout_weight="1"
                                android:background="@drawable/botoncircular"
                                android:paddingStart="6dp"
                                android:text="@string/referencia"
                                tools:ignore="RtlSymmetry,TooDeepLayout" />

                            <EditText
                                android:id="@+id/etRefe"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:autofillHints="@string/todo"
                                android:backgroundTint="@color/color"
                                android:ems="10"
                                android:inputType="textAutoCorrect"
                                tools:ignore="LabelFor,SpeakableTextPresentCheck,TextFields,TouchTargetSizeCheck" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Botones de acción -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="97dp"
                        android:layout_marginStart="9dp"
                        android:layout_marginEnd="9dp"
                        android:gravity="bottom"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btAnadir"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="@drawable/botoncircular"
                            android:backgroundTint="@color/verde"
                            android:text="@string/a_adir"
                            android:textColor="@color/blanco"
                            tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btLimpiar"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="4.5dp"
                                android:layout_weight="1"
                                android:background="@drawable/botoncircular"
                                android:backgroundTint="@color/color"
                                android:foregroundGravity="center"
                                android:text="@string/limpiar"
                                android:textColor="@color/blanco"
                                tools:ignore="ButtonStyle,TouchTargetSizeCheck,TextContrastCheck" />

                            <Button
                                android:id="@+id/btOpti"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="4.5dp"
                                android:layout_weight="1"
                                android:background="@drawable/botoncircular"
                                android:backgroundTint="@color/rojo"
                                android:text="@string/calcular"
                                android:textColor="@color/blanco"
                                tools:ignore="ButtonStyle,TextContrastCheck,TooManyViews,TouchTargetSizeCheck" />

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- tvResultado oculto para compatibilidad -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="9dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <EditText
                    android:id="@+id/tvResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
