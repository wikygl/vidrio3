<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor de la disposición de la mampara paflón.

  Cada módulo se toca para alternar fijo/corrediza, igual que el diálogo de Nova pero editando en
  vez de elegir de un catálogo: la mampara admite combinaciones que ninguna tabla cubre.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diseño de la mampara"
            android:textColor="@color/azul"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toca un módulo para cambiarlo entre fijo y corrediza."
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Un bloque por tramo, generado en código: el número de tramos es variable. -->
        <LinearLayout
            android:id="@+id/dmContenedorTramos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/dmResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/azul"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dmAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B4460E"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#DDDDDD" />

        <!-- Añadir y quitar tramos. Entre tramos va un parante estructural de paflón, así que no
             es lo mismo que añadir módulos: cambia la estructura, no solo el reparto. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tramos"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/dmQuitarTramo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="−"
                android:textSize="18sp" />

            <Button
                android:id="@+id/dmAgregarTramo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="48dp"
                android:text="+"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#DDDDDD" />

        <!-- Cuántas mamparas iguales: al archivar se guarda una copia por unidad, numeradas
             seguidas, así que el material queda multiplicado. Mismo sitio que en las demás
             calculadoras. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/dmCantidad"
                android:text="Cantidad"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/dmCantidad"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:text="1" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="iguales, numeradas seguidas"
                android:textColor="#333333"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- La mampara paflón no lleva marco inferior: se apoya en el piso o en el plato de ducha.
             Cuando el trabajo sí lo pide, se marca aquí y la hoja se apoya sobre él. -->
        <CheckBox
            android:id="@+id/dmMarcoInferior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="false"
            android:text="Con marco inferior"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="La hoja se apoya sobre el marco y conserva su alto: la altura de puente es interna, así que lo que se acorta es la mocheta de arriba."
            android:textColor="#666666"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dmAuto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Automático"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/dmAplicar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/celeste"
                android:text="Aplicar"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
