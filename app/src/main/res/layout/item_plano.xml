<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de tamaño fijo (pantalla completa). El texto es de tamaño fijo (sp) y el plano
     se adecúa al espacio restante (no al revés). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="9dp"
    android:background="@color/sombra2"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvTituloPlano"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDatosPlano"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#000000"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/ivPlano"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="#FFFFFF"
        android:scaleType="fitCenter" />
</LinearLayout>
