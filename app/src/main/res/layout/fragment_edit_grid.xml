<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_edit_grid.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editGridLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- El dibujo y, encima, el mando flotante para añadir y quitar divisiones. Van en un
         FrameLayout para que el mando pueda moverse por encima sin empujar nada. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8">

        <crystal.crystal.taller.GridDrawingView
            android:id="@+id/gridDrawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp" />

        <!-- Mando de divisiones. Arrastrable: el usuario lo aparta de donde estorbe.
             En reposo muestra la rejilla; al tocarlo salen filas y columnas; al elegir una,
             el icono la sustituye y aparecen + y −. -->
        <LinearLayout
            android:id="@+id/mandoDivisiones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btMando"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_boton_flotante"
                android:contentDescription="@string/divisiones_del_dise_o"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_grilla" />

            <ImageButton
                android:id="@+id/btMandoUno"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_boton_flotante_claro"
                android:contentDescription="@string/filas"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_filas"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btMandoDos"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_boton_flotante_claro"
                android:contentDescription="@string/columnas"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_columnas"
                android:visibility="gone" />

            <!-- Ámbito: decide si la fila se añade y se quita en todas las columnas o solo en la
                 elegida. Solo aparece con el eje de filas, porque una columna atraviesa el alto
                 entero y no admite ese matiz. -->
            <ImageButton
                android:id="@+id/btMandoAmbito"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_boton_flotante_claro"
                android:contentDescription="@string/mbito_de_la_fila"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ambito_todas"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- ScrollView para contener los inputs si son muchos -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Layout para los EditText de columnas -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/columnInputsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="2dp" />
            </HorizontalScrollView>

            <!-- Nuevo Layout para los inputs de filas por columna -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/filasPorColumnaLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:padding="2dp" />
                </HorizontalScrollView>
            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Botón opcional para cerrar el fragmento -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonClose"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="Aprobar" />

        <Button
            android:id="@+id/buttonGrilla"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="Grilla" />

        <Button
            android:id="@+id/buttonEstructura"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="Estructura" />

        <Button
            android:id="@+id/buttonVidrio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="Vidrio" />
    </LinearLayout>

</LinearLayout>
