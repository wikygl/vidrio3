<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicar (o editar) un anuncio de la Tienda: qué es, el texto, el precio, el estado, la ciudad y
  hasta 5 fotos. Abajo, lo que cuesta y el saldo antes de cobrar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sombra"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnAtras"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@null"
            android:contentDescription="Atrás"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/blanco" />

        <TextView
            android:id="@+id/tvTituloPantalla"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="Publicar anuncio"
            android:textColor="@color/blanco"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/SeccionItem"
                android:text="QUÉ OFRECE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnProducto"
                    style="@style/AccionItem"
                    android:text="Producto" />

                <Button
                    android:id="@+id/btnServicio"
                    style="@style/AccionItem"
                    android:text="Servicio" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/SeccionItem"
                android:text="EL ANUNCIO" />

            <EditText
                android:id="@+id/etTitulo"
                style="@style/CampoItem"
                android:layout_width="match_parent"
                android:layout_weight="0"
                android:hint="Título (ej.: Vidrio templado 8 mm incoloro)"
                android:inputType="textCapSentences"
                android:maxLength="80" />

            <EditText
                android:id="@+id/etDescripcion"
                style="@style/CampoItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="0"
                android:gravity="top"
                android:hint="Descripción: medidas, marca, estado, entrega…"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1500"
                android:maxLines="10"
                android:minLines="4"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="15sp" />

            <TextView
                style="@style/SeccionItem"
                android:text="PRECIO" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="S/"
                    android:textColor="#5A5A5A"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/etPrecio"
                    style="@style/CampoItem"
                    android:hint="0.00"
                    android:inputType="numberDecimal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="4dp"
                    android:text="por"
                    android:textColor="#5A5A5A"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/spUnidad"
                    android:layout_width="120dp"
                    android:layout_height="48dp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbATratar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Precio a tratar (no se muestra un monto)" />

            <LinearLayout
                android:id="@+id/lyCondicion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SeccionItem"
                    android:text="ESTADO" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNuevo"
                        style="@style/AccionItem"
                        android:text="Nuevo" />

                    <Button
                        android:id="@+id/btnUsado"
                        style="@style/AccionItem"
                        android:text="Usado" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvRotuloCiudad"
                style="@style/SeccionItem"
                android:text="UBICACIÓN" />

            <EditText
                android:id="@+id/etCiudad"
                style="@style/CampoItem"
                android:layout_width="match_parent"
                android:layout_weight="0"
                android:hint="Ciudad o zona (ej.: Huancayo)"
                android:inputType="textCapWords"
                android:maxLength="60" />

            <!-- Solo los servicios: también se encuentran buscando estas zonas. -->
            <LinearLayout
                android:id="@+id/lyZonas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SeccionItem"
                    android:text="OTRAS ZONAS DONDE ATIENDE (OPCIONAL)" />

                <EditText
                    android:id="@+id/etZonas"
                    style="@style/CampoItem"
                    android:layout_width="match_parent"
                    android:layout_weight="0"
                    android:hint="Separadas por comas: El Tambo, Chilca"
                    android:inputType="textCapWords"
                    android:maxLength="220" />
            </LinearLayout>

            <TextView
                style="@style/SeccionItem"
                android:text="FOTOS (HASTA 5)" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/contenedorFotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvCosto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_resumen_item"
                android:padding="12dp"
                android:textColor="@color/negro"
                android:textSize="14sp"
                tools:text="Publicar cuesta S/ 3.00 y dura 30 días. Su saldo: S/ 7.00" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnPublicar"
        style="@style/AccionItem.Principal"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_weight="0"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:text="Publicar"
        android:textSize="16sp" />
</LinearLayout>
