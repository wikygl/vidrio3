<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor del diseño de la ventana serie 84 (y 84 económica). Calcado del de la mampara paflón:
  por tramo, las hojas (fijo/corrediza, con su ancho si se fija) y las franjas de abajo arriba
  (hojas y mochetas, con su alto si se fija).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diseño de la ventana"
            android:textColor="@color/azul"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toca una hoja para cambiarla entre fijo y corrediza; mantenla pulsada para fijar su ancho. Toca una franja para fijar su alto o quitarla."
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Un bloque por tramo, generado en código: el número de tramos es variable. -->
        <LinearLayout
            android:id="@+id/d84ContenedorTramos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/d84Resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/azul"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/d84Aviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B4460E"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#DDDDDD" />

        <!-- Añadir y quitar tramos. Entre tramos va un parante de tubo. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tramos"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/d84QuitarTramo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="−"
                android:textSize="18sp" />

            <Button
                android:id="@+id/d84AgregarTramo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="48dp"
                android:text="+"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#DDDDDD" />

        <!-- Cuántas ventanas iguales: mismo sitio que en las demás calculadoras. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/d84Cantidad"
                android:text="Cantidad"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/d84Cantidad"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:text="1" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="iguales, numeradas seguidas"
                android:textColor="#333333"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/d84Auto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Automático"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/d84Aplicar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/celeste"
                android:text="Aplicar"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
