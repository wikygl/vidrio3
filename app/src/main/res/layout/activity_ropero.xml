<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F4EC"
    android:orientation="vertical"
    tools:context=".taller.melamina.RoperoActivity">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/corner2"
        android:backgroundTint="@color/color"
        android:gravity="center"
        android:padding="6dp"
        android:text="Ropero empotrado · melamina"
        android:textColor="@color/blanco"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- El hueco -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/RotuloRopero" android:text="Ancho del hueco (cm)" />
                <TextView style="@style/RotuloRopero" android:text="Alto (cm)" />
                <TextView style="@style/RotuloRopero" android:text="Fondo (cm)" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etAncho"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ancho (cm)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:text="240" />

                <EditText
                    android:id="@+id/etAlto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Alto (cm)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:text="240" />

                <EditText
                    android:id="@+id/etFondo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Fondo (cm)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:text="60" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/RotuloRopero" android:text="Zócalo (cm)" />
                <TextView style="@style/RotuloRopero" android:text="Maletero (cm, 0 = sin)" />
                <TextView style="@style/RotuloRopero" android:text="Cuerpos" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etZocalo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Zócalo (cm)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:text="10" />

                <EditText
                    android:id="@+id/etMaletero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Maletero (cm, 0 = no)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:text="0" />

                <EditText
                    android:id="@+id/etCuerpos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Cuerpos"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:text="2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spPuertas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2" />

                <Spinner
                    android:id="@+id/spEspesor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9" />

                <CheckBox
                    android:id="@+id/cbFondo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Fondo nordex"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Toca un cuerpo en el dibujo para elegir qué lleva (colgador, entrepaños, cajones) y su ancho."
                android:textColor="#6D5A45"
                android:textSize="11sp" />

            <crystal.crystal.taller.melamina.VistaRopero
                android:id="@+id/vistaRopero"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="4dp"
                android:background="#FFFDF8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btPuertas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ver puertas"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/bt3d"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ver en 3D"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btCalcular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Calcular"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReferenciasTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="Referencias"
                android:textColor="@android:color/black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txReferencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#333333"
                android:textSize="12sp" />

            <!-- Las listas de material se arman aquí, una por una: título y líneas "medida = cantidad". -->
            <LinearLayout
                android:id="@+id/lyMateriales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvCorteTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="Lista de corte"
                android:textColor="@android:color/black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txCorte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#333333"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvProyectoActivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btArchivar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Archivar"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btOptimizar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Planchas"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btCompartir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Compartir"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
