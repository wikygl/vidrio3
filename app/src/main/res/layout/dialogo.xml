<?xml version="1.0" encoding="utf-8"?>
<!--
  El diálogo que se abre al tocar un ítem de la lista de medidas (MainActivity.eliminar()).

  Arriba, el ítem: qué es, cuánto mide y cuánto cuesta. Debajo, las acciones en dos grupos —las de
  ESTE ítem y las de TODA la lista—, todas del mismo tamaño. Al tocar Editar, las acciones se
  esconden y aparece el formulario a lo ancho, con la cuenta al día mientras se escribe.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/layout_dialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- El ítem -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_resumen_item"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvTituloItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/azul"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Ventana nova" />

            <TextView
                android:id="@+id/tvEscala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#4A4A4A"
                android:textSize="14sp"
                tools:text="124.5 × 89.5 cm  ·  cant. 1" />

            <TextView
                android:id="@+id/tvResumenItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/negro"
                android:textSize="15sp"
                tools:text="S/ 7.40   ·   12.8 p2   ·   1.2 m²" />

            <TextView
                android:id="@+id/tvMarcasItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/color"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Sala de partos  ·  3 opciones (elegida la B)"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Las acciones -->
        <LinearLayout
            android:id="@+id/lyAcciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SeccionItem"
                android:text="ESTE ÍTEM" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_dialogo_editar"
                    style="@style/AccionItem.Principal"
                    android:text="Editar" />

                <Button
                    android:id="@+id/btnOpciones"
                    style="@style/AccionItem"
                    android:text="Opciones" />

                <Button
                    android:id="@+id/btnAmbiente"
                    style="@style/AccionItem"
                    android:text="Ambiente" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btAbrir"
                    style="@style/AccionItem"
                    android:text="Anexar" />

                <Button
                    android:id="@+id/btnMedir"
                    style="@style/AccionItem"
                    android:text="Medir" />

                <Button
                    android:id="@+id/btn_dialogo_eliminar"
                    style="@style/AccionItem.Eliminar"
                    android:text="Eliminar" />
            </LinearLayout>

            <TextView
                style="@style/SeccionItem"
                android:text="TODA LA LISTA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGuardar"
                    style="@style/AccionItem"
                    android:text="Guardar" />

                <Button
                    android:id="@+id/btnEnviarJson"
                    style="@style/AccionItem"
                    android:text="Enviar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnContrato"
                    style="@style/AccionItem"
                    android:text="Contrato" />

                <Button
                    android:id="@+id/btnCortes"
                    style="@style/AccionItem"
                    android:text="Cortes" />
            </LinearLayout>
        </LinearLayout>

        <!-- La edición: a lo ancho, cada campo con su rótulo y su unidad -->
        <LinearLayout
            android:id="@+id/lyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/lyMed1"
                style="@style/FilaCampoItem">

                <TextView
                    android:id="@+id/tvRotuloMed1"
                    style="@style/RotuloCampoItem"
                    android:text="Ancho" />

                <EditText
                    android:id="@+id/etdMed1"
                    style="@style/CampoItem"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    tools:ignore="LabelFor" />

                <TextView
                    android:id="@+id/tvUnidadMed1"
                    style="@style/UnidadCampoItem"
                    tools:text="cm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyMed2"
                style="@style/FilaCampoItem">

                <TextView
                    android:id="@+id/tvRotuloMed2"
                    style="@style/RotuloCampoItem"
                    android:text="Alto" />

                <EditText
                    android:id="@+id/etdMed2"
                    style="@style/CampoItem"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    tools:ignore="LabelFor" />

                <TextView
                    android:id="@+id/tvUnidadMed2"
                    style="@style/UnidadCampoItem"
                    tools:text="cm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyMed3"
                style="@style/FilaCampoItem">

                <TextView
                    style="@style/RotuloCampoItem"
                    android:text="Fondo" />

                <EditText
                    android:id="@+id/etdMed3"
                    style="@style/CampoItem"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    tools:ignore="LabelFor" />

                <TextView
                    android:id="@+id/tvUnidadMed3"
                    style="@style/UnidadCampoItem"
                    tools:text="cm" />
            </LinearLayout>

            <LinearLayout style="@style/FilaCampoItem">

                <TextView
                    style="@style/RotuloCampoItem"
                    android:text="Cantidad" />

                <EditText
                    android:id="@+id/etdCant"
                    style="@style/CampoItem"
                    android:hint="1"
                    android:inputType="numberDecimal"
                    tools:ignore="LabelFor" />

                <TextView
                    style="@style/UnidadCampoItem"
                    android:text="und." />
            </LinearLayout>

            <LinearLayout style="@style/FilaCampoItem">

                <TextView
                    style="@style/RotuloCampoItem"
                    android:text="Precio S/" />

                <EditText
                    android:id="@+id/etdPrecio"
                    style="@style/CampoItem"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    tools:ignore="LabelFor" />

                <TextView
                    android:id="@+id/tvUnidadPrecio"
                    style="@style/UnidadCampoItem"
                    tools:text="x p2" />
            </LinearLayout>

            <LinearLayout style="@style/FilaCampoItem">

                <TextView
                    style="@style/RotuloCampoItem"
                    android:text="Producto" />

                <EditText
                    android:id="@+id/etdProducto"
                    style="@style/CampoItem"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:minHeight="48dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textSize="16sp"
                    tools:ignore="LabelFor" />

                <Space
                    android:layout_width="52dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <!-- La cuenta con lo que se va escribiendo: así se ve el costo antes de guardar -->
            <TextView
                android:id="@+id/tvVistaPrevia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_resumen_item"
                android:padding="10dp"
                android:textColor="@color/negro"
                android:textSize="15sp"
                tools:text="Nuevo costo: S/ 7.40   ·   12.8 p2   ·   1.2 m²" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEnviarItem"
                    style="@style/AccionItem"
                    android:text="Enviar ítem" />

                <Button
                    android:id="@+id/btnCancelarEdicion"
                    style="@style/AccionItem"
                    android:text="Cancelar" />

                <Button
                    android:id="@+id/btnDiaOk"
                    style="@style/AccionItem.Principal"
                    android:text="Guardar" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
