<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedorPrincipal"
    android:layout_height="match_parent"
    android:background="@color/sombra"
    android:layout_width="match_parent">

    <LinearLayout
        android:id="@+id/panelInfoSeleccion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/bg_control_panel"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvInfoSeleccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona una franja en un tramo"
            android:textColor="@android:color/black"
            android:textSize="12sp" />
    </LinearLayout>

    <crystal.crystal.Diseno.nova.VistaDiseno
        android:id="@+id/vistaDiseno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="180dp"
        android:contentDescription="Lienzo de diseno"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/panelInfoSeleccion" />


    <!-- Mando de la franja o el módulo tocados. Va pegado encima del bloque de controles y no
         sobre el dibujo: encima tapaba justo lo que se estaba editando. El lienzo se encoge solo
         para dejarle sitio. -->
    <LinearLayout
        android:id="@+id/contenedorFlotante"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_control_panel"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/overlayControles"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <!-- Panel flotante de controles -->
    <FrameLayout
        android:id="@+id/overlayControles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/columnaBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="6dp"
            android:padding="8dp">

            <!-- Panel de controles (aparece arriba) -->

            <!-- Fila inferior de botones control -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/filaControles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:id="@+id/panelCotasPlanos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_control_panel"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@+id/btnCotasPlanos"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:id="@+id/tvTituloCotas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Cotas"
                        android:textStyle="bold" />

                    <!-- El alto lo limita la pantalla, en limitarAltoDelPanel: android:maxHeight
                         no vale aquí, ScrollView no lo respeta y el panel crecía hasta tapar el
                         diseño. -->
                    <ScrollView
                        android:id="@+id/scrollCotas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/contenedorCotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnMostrarOcultar"
                    style="@style/DisenoNova.ControlButton"
                    android:background="@drawable/bg_control_blue"
                    android:contentDescription="Opciones del diseno"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:srcCompat="@drawable/ic_toggle_controls" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnMedidasRapidas"
                    style="@style/DisenoNova.ControlButton"
                    android:background="@drawable/bg_control_blue"
                    android:contentDescription="Medidas rapidas"
                    app:layout_constraintBottom_toBottomOf="@+id/btnMostrarOcultar"
                    app:layout_constraintStart_toEndOf="@+id/btnMostrarOcultar"
                    app:layout_constraintTop_toTopOf="@+id/btnMostrarOcultar"
                    app:srcCompat="@drawable/ic_measures" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnCotasPlanos"
                    style="@style/DisenoNova.ControlButton"
                    android:background="@drawable/bg_control_blue"
                    android:contentDescription="Cotas de planos"
                    app:layout_constraintBottom_toBottomOf="@+id/btnMostrarOcultar"
                    app:layout_constraintStart_toEndOf="@+id/btnMedidasRapidas"
                    app:layout_constraintTop_toTopOf="@+id/btnMostrarOcultar"
                    app:srcCompat="@drawable/cota" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnTipoEnsamble"
                    style="@style/DisenoNova.ControlButton"
                    android:background="@drawable/bg_control_blue"
                    android:contentDescription="Alternar tipo de ensamble"
                    app:layout_constraintBottom_toBottomOf="@+id/btnMostrarOcultar"
                    app:layout_constraintStart_toEndOf="@+id/btnCotasPlanos"
                    app:layout_constraintTop_toTopOf="@+id/btnMostrarOcultar"
                    app:srcCompat="@drawable/ic_toggle_mode" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnEnviarCalculadora"
                    style="@style/DisenoNova.ControlButton"
                    android:background="@drawable/bg_control_blue"
                    android:contentDescription="Enviar a calculadora"
                    android:padding="9dp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnMostrarOcultar"
                    app:layout_constraintStart_toEndOf="@+id/btnTipoEnsamble"
                    app:layout_constraintTop_toTopOf="@+id/btnMostrarOcultar"
                    app:srcCompat="@drawable/calcu" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnLimpiarDiseno"
                    style="@style/DisenoNova.ControlButton"
                    android:background="@drawable/bg_control_blue"
                    android:contentDescription="Limpiar diseno"
                    app:layout_constraintBottom_toBottomOf="@+id/btnMostrarOcultar"
                    app:layout_constraintStart_toEndOf="@+id/btnEnviarCalculadora"
                    app:layout_constraintTop_toTopOf="@+id/btnMostrarOcultar"
                    app:srcCompat="@drawable/escoba" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
