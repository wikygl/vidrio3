<?xml version="1.0" encoding="utf-8"?>
<!--
  La vitrina propia del proveedor: el estado (vigente hasta, vencida, bloqueada), la ficha que ven los
  talleres (logo, nombre, ciudad, zonas, rubros, descripción) y, abajo, activar o renovar con su precio.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sombra"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnAtras"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@null"
            android:contentDescription="Atrás"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/blanco" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="Mi vitrina de proveedor"
            android:textColor="@color/blanco"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_resumen_item"
                android:padding="12dp"
                android:textColor="@color/negro"
                android:textSize="14sp"
                tools:text="Su vitrina está activa hasta el 12/11/2026." />

            <TextView
                style="@style/SeccionItem"
                android:text="LOGO (OPCIONAL)" />

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_accion_item"
                android:contentDescription="Elegir logo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tienda_vacio" />

            <TextView
                style="@style/SeccionItem"
                android:text="NOMBRE DEL NEGOCIO" />

            <EditText
                android:id="@+id/etNombre"
                style="@style/CampoItem"
                android:layout_width="match_parent"
                android:layout_weight="0"
                android:hint="Ej.: Vidriería Los Andes"
                android:inputType="textCapWords"
                android:maxLength="60" />

            <TextView
                style="@style/SeccionItem"
                android:text="CIUDAD" />

            <EditText
                android:id="@+id/etCiudad"
                style="@style/CampoItem"
                android:layout_width="match_parent"
                android:layout_weight="0"
                android:hint="Ej.: Huancayo"
                android:inputType="textCapWords"
                android:maxLength="60" />

            <TextView
                style="@style/SeccionItem"
                android:text="OTRAS ZONAS QUE ATIENDE (OPCIONAL)" />

            <EditText
                android:id="@+id/etZonas"
                style="@style/CampoItem"
                android:layout_width="match_parent"
                android:layout_weight="0"
                android:hint="Separadas por comas: El Tambo, Chilca"
                android:inputType="textCapWords"
                android:maxLength="220" />

            <TextView
                style="@style/SeccionItem"
                android:text="QUÉ VENDE" />

            <LinearLayout
                android:id="@+id/contenedorRubros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/SeccionItem"
                android:text="DESCRIPCIÓN" />

            <EditText
                android:id="@+id/etDescripcion"
                style="@style/CampoItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:gravity="top"
                android:hint="Qué ofrece, horarios, entregas, formas de pago…"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="600"
                android:maxLines="8"
                android:minLines="3"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCosto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_resumen_item"
                android:padding="12dp"
                android:textColor="@color/negro"
                android:textSize="14sp"
                tools:text="La vitrina cuesta S/ 10.00 por 30 días. Su saldo: S/ 25.00." />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnGuardar"
            style="@style/AccionItem"
            android:layout_height="52dp"
            android:text="Guardar cambios"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnActivar"
            style="@style/AccionItem.Principal"
            android:layout_height="52dp"
            android:text="Activar vitrina" />
    </LinearLayout>
</LinearLayout>
