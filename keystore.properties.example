# Plantilla de firma de release. COPIA este archivo como `keystore.properties` (en la raíz del repo)
# y rellena los valores reales. `keystore.properties` y el .jks están en .gitignore: NO se versionan.
#
# storeFile: ruta al keystore, relativa a la raíz del repo (o absoluta).
# Genera el keystore una sola vez con:
#   keytool -genkeypair -v -keystore crystal-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias crystal-upload
#
# GUARDA el .jks y estas contraseñas en un lugar seguro y con respaldo: si los pierdes, no podrás
# volver a subir actualizaciones de la app a Google Play.

storeFile=crystal-upload.jks
storePassword=CAMBIA_ESTA_CONTRASENA
keyAlias=crystal-upload
keyPassword=CAMBIA_ESTA_CONTRASENA
