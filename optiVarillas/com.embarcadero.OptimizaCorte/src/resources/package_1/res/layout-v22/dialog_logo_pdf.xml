<?xml version='1.0' encoding='utf-8' ?>
<androidx.cardview.widget.CardView android:layout_width="fill_parent"
                      android:layout_height="wrap_content"
                      OptimizaCorte:cardCornerRadius="8.0dp"
                      OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
                      OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                      OptimizaCorte:layout_constraintStart_toStartOf="parent"
                      OptimizaCorte:layout_constraintTop_toTopOf="parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:OptimizaCorte="http://schemas.android.com/apk/res-auto">
  <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
    <ImageView android:id="@id/iv_pdf"
               android:layout_width="150.0dp"
               android:layout_height="150.0dp"
               android:layout_marginTop="32.0dp"
               OptimizaCorte:layout_constraintEnd_toEndOf="parent"
               OptimizaCorte:layout_constraintStart_toStartOf="parent"
               OptimizaCorte:layout_constraintTop_toTopOf="parent"
               OptimizaCorte:srcCompat="@drawable/ic_launcher" />
    <Button android:id="@id/btn_ok_logo"
            android:paddingLeft="18.0dp"
            android:paddingRight="18.0dp"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dp"
            android:layout_marginBottom="32.0dp"
            android:text="@string/btn_confirm_logo"
            android:textAllCaps="false"
            android:paddingHorizontal="18.0dp"
            OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
            OptimizaCorte:layout_constraintEnd_toEndOf="@id/btn_replace_logo"
            OptimizaCorte:layout_constraintStart_toStartOf="@id/btn_reset_logo"
            OptimizaCorte:layout_constraintTop_toBottomOf="@id/textInputLayout2"
            OptimizaCorte:layout_constraintVertical_bias="0.1"
            style="@style/AppTheme.RoundedCornerMaterialButtonGreen" />
    <Button android:id="@id/btn_reset_logo"
            android:paddingLeft="18.0dp"
            android:paddingRight="18.0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dp"
            android:text="@string/btn_reset_logo"
            android:textAllCaps="false"
            android:layout_marginStart="32.0dp"
            android:paddingHorizontal="18.0dp"
            OptimizaCorte:layout_constraintStart_toStartOf="parent"
            OptimizaCorte:layout_constraintTop_toBottomOf="@id/iv_pdf"
            style="@style/AppTheme.RoundedCornerMaterialButtonRed" />
    <Button android:id="@id/btn_replace_logo"
            android:paddingLeft="18.0dp"
            android:paddingRight="18.0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dp"
            android:text="@string/btn_change_logo"
            android:textAllCaps="false"
            android:layout_marginEnd="32.0dp"
            android:paddingHorizontal="18.0dp"
            OptimizaCorte:layout_constraintEnd_toEndOf="parent"
            OptimizaCorte:layout_constraintTop_toBottomOf="@id/iv_pdf"
            style="@style/AppTheme.RoundedCornerMaterialButtonBlue" />
    <com.google.android.material.textfield.TextInputLayout android:id="@id/textInputLayout1"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:layout_marginTop="8.0dp"
                          android:hint="Text line 1"
                          android:textAlignment="center"
                          OptimizaCorte:layout_constraintEnd_toEndOf="@id/btn_replace_logo"
                          OptimizaCorte:layout_constraintStart_toStartOf="@id/btn_reset_logo"
                          OptimizaCorte:layout_constraintTop_toBottomOf="@id/btn_reset_logo">
      <com.google.android.material.textfield.TextInputEditText android:id="@id/edTextLine1"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:maxLength="50" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@id/textInputLayout2"
                          android:layout_width="0.0dp"
                          android:layout_height="wrap_content"
                          android:hint="Text line 2"
                          OptimizaCorte:layout_constraintEnd_toEndOf="@id/btn_replace_logo"
                          OptimizaCorte:layout_constraintStart_toStartOf="@id/btn_reset_logo"
                          OptimizaCorte:layout_constraintTop_toBottomOf="@id/textInputLayout1">
      <com.google.android.material.textfield.TextInputEditText android:id="@id/edTextLine2"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:maxLength="50" />
    </com.google.android.material.textfield.TextInputLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>