<?xml version='1.0' encoding='utf-8' ?>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="fill_parent"
                      android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:OptimizaCorte="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="horizontal"
                android:id="@id/layout_input_edit"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:weightSum="15.0"
                android:layout_alignParentTop="true"
                OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                OptimizaCorte:layout_constraintStart_toStartOf="parent"
                OptimizaCorte:layout_constraintTop_toTopOf="parent">
    <com.google.android.material.textfield.TextInputLayout android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          android:layout_margin="5.0dp"
                          android:hint="@string/edt_medida"
                          android:layout_weight="5.0"
                          android:textAlignment="center">
      <com.google.android.material.textfield.TextInputEditText android:id="@id/edMedida_edit"
                            android:nextFocusDown="@id/edUds_edit"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textAlignment="center" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          android:layout_margin="5.0dp"
                          android:hint="@string/edt_unidades"
                          android:layout_weight="5.0"
                          android:textAlignment="center">
      <com.google.android.material.textfield.TextInputEditText android:id="@id/edUds_edit"
                            android:nextFocusDown="@id/edRef_edit"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textAlignment="center" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          android:layout_margin="5.0dp"
                          android:hint="@string/edt_ref"
                          android:layout_weight="5.0"
                          android:textAlignment="center">
      <com.google.android.material.textfield.TextInputEditText android:id="@id/edRef_edit"
                            android:nextFocusDown="@id/edMedida_edit"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:maxLength="5"
                            android:inputType="textNoSuggestions"
                            android:textAlignment="center" />
    </com.google.android.material.textfield.TextInputLayout>
  </LinearLayout>
  <androidx.constraintlayout.widget.ConstraintLayout android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                        OptimizaCorte:layout_constraintStart_toStartOf="parent"
                        OptimizaCorte:layout_constraintTop_toBottomOf="@id/layout_input_edit">
    <ImageButton android:id="@id/iBCutType_edit"
                 android:padding="15.0dp"
                 android:layout_width="0.0dp"
                 android:layout_height="50.0dp"
                 android:layout_marginLeft="50.0dp"
                 android:layout_marginTop="5.0dp"
                 android:layout_marginRight="50.0dp"
                 android:layout_marginBottom="5.0dp"
                 android:scaleType="fitCenter"
                 android:layout_marginHorizontal="50.0dp"
                 android:layout_marginVertical="5.0dp"
                 OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
                 OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                 OptimizaCorte:layout_constraintStart_toStartOf="parent"
                 OptimizaCorte:layout_constraintTop_toTopOf="parent"
                 OptimizaCorte:srcCompat="@drawable/rect"
                 style="@style/AppTheme.RoundedCornerMaterialButtonGreen" />
    <ImageView android:layout_gravity="bottom|center|end"
               android:id="@id/ivLock_edit"
               android:layout_width="16.0dp"
               android:layout_height="16.0dp"
               android:layout_marginLeft="26.0dp"
               android:layout_marginTop="22.0dp"
               android:layout_marginRight="26.0dp"
               android:layout_marginBottom="22.0dp"
               android:src="@drawable/baseline_lock_24"
               android:scaleType="fitCenter"
               android:layout_marginHorizontal="26.0dp"
               android:layout_marginVertical="22.0dp"
               OptimizaCorte:layout_constraintBottom_toBottomOf="@id/iBCutType_edit"
               OptimizaCorte:layout_constraintEnd_toEndOf="@id/iBCutType_edit"
               OptimizaCorte:layout_constraintTop_toTopOf="@id/iBCutType_edit" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>