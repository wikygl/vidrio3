                                android:layout_width="0.0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8.0dp"
                                android:layout_marginBottom="8.0dp"
                                android:checked="true"
                                android:text="@string/sw_experimental"
                                android:switchPadding="16.0dp"
                                OptimizaCorte:layout_constraintEnd_toEndOf="@id/seekBar_opt"
                                OptimizaCorte:layout_constraintStart_toStartOf="@id/seekBar_opt"
                                OptimizaCorte:layout_constraintTop_toBottomOf="@id/textView9" />
          <SeekBar android:id="@id/seekBar_opt"
                   android:layout_width="fill_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="8.0dp"
                   android:max="3"
                   android:progress="2"
                   android:layout_marginStart="16.0dp"
                   android:layout_marginEnd="16.0dp"
                   OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                   OptimizaCorte:layout_constraintStart_toStartOf="parent"
                   OptimizaCorte:layout_constraintTop_toBottomOf="@id/switch_experimental"
