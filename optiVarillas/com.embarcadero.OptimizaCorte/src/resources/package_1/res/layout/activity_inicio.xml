            android:layout_marginBottom="8.0dp"
            android:text="@string/btn_retales_adv"
            android:layout_marginStart="24.0dp"
            OptimizaCorte:layout_constraintBottom_toTopOf="@id/button_remove_ads"
            OptimizaCorte:layout_constraintStart_toStartOf="parent"
            OptimizaCorte:layout_constraintTop_toTopOf="parent"
            style="@style/AppTheme.RoundedCornerMaterialButtonRed" />
    <Button android:id="@id/button_ok"
            android:layout_width="150.0dp"
            android:layout_height="48.0dp"
            android:layout_marginTop="8.0dp"
            android:layout_marginBottom="8.0dp"
            android:maxHeight="48.0dp"
            android:text="@string/str_aceptar"
            android:layout_marginEnd="24.0dp"
            OptimizaCorte:layout_constraintBottom_toTopOf="@id/button_remove_ads"
            OptimizaCorte:layout_constraintEnd_toEndOf="parent"
            OptimizaCorte:layout_constraintTop_toTopOf="parent"
            style="@style/AppTheme.RoundedCornerMaterialButtonGreen" />
    <Button android:id="@id/button_remove_ads"
