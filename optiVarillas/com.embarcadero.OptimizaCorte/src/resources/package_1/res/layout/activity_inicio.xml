                    OptimizaCorte:layout_constraintStart_toStartOf="@id/seekBar_opt"
                    OptimizaCorte:layout_constraintTop_toBottomOf="@id/seekBar_opt" />
          <TextView android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/best_slow"
                    OptimizaCorte:layout_constraintEnd_toEndOf="@id/seekBar_opt"
                    OptimizaCorte:layout_constraintTop_toBottomOf="@id/seekBar_opt" />
          <androidx.appcompat.widget.SwitchCompat android:textSize="12.0sp"
                                android:id="@id/switch_engine"
                                android:layout_width="0.0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8.0dp"
                                android:checked="true"
                                android:text="@string/combine_and_best"
                                android:switchPadding="16.0dp"
                                OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
                                OptimizaCorte:layout_constraintEnd_toEndOf="@id/seekBar_opt"
                                OptimizaCorte:layout_constraintStart_toStartOf="@id/seekBar_opt" />
        </androidx.constraintlayout.widget.ConstraintLayout>
      </androidx.cardview.widget.CardView>
      <TextView android:textSize="12.0sp"
                android:id="@id/tv_version"
