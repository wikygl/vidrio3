                            android:layout_marginStart="16.0dp"
                            android:layout_marginEnd="16.0dp"
                            OptimizaCorte:cardCornerRadius="16.0dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:orientation="horizontal"
                              android:id="@id/linear1"
                              android:layout_width="fill_parent"
                              android:layout_height="fill_parent">
          <TextView android:textSize="14.0sp"
                    android:textColor="@color/cutter_colorPrimary"
                    android:id="@id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
                    android:text="@string/card_measure_system"
