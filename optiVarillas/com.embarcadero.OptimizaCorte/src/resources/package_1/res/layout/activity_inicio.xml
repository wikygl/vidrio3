      </androidx.cardview.widget.CardView>
      <androidx.cardview.widget.CardView android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16.0dp"
                            android:layout_marginStart="16.0dp"
                            android:layout_marginEnd="16.0dp"
                            OptimizaCorte:cardCornerRadius="16.0dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@id/constr_1"
                              android:layout_width="fill_parent"
                              android:layout_height="wrap_content">
          <TextView android:textSize="14.0sp"
                    android:textColor="@color/cutter_colorPrimary"
                    android:id="@id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
                    android:text="@string/card_stock"
                    android:layout_alignParentTop="true"
                    OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                    OptimizaCorte:layout_constraintStart_toStartOf="parent"
                    OptimizaCorte:layout_constraintTop_toTopOf="parent" />
          <ListView android:id="@id/lv_stock"
