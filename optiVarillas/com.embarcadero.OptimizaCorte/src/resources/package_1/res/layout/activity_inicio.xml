                    android:layout_height="100.0dp"
                    android:layout_marginLeft="8.0dp"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginRight="8.0dp"
                    OptimizaCorte:layout_constraintBottom_toTopOf="@id/constraintLayout2"
                    OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                    OptimizaCorte:layout_constraintStart_toStartOf="parent"
                    OptimizaCorte:layout_constraintTop_toBottomOf="@id/textView" />
          <androidx.constraintlayout.widget.ConstraintLayout android:id="@id/constraintLayout2"
