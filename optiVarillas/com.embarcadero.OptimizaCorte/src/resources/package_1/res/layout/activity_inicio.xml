                    android:layout_height="30.0dp"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:text="@string/btn_anadir"
                    android:layout_marginEnd="24.0dp"
                    OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
                    OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                    OptimizaCorte:layout_constraintTop_toTopOf="parent"
                    style="@style/AppTheme.RoundedCornerMaterialButtonGreen" />
          </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
      </androidx.cardview.widget.CardView>
      <androidx.cardview.widget.CardView android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16.0dp"
                            android:layout_marginStart="16.0dp"
                            android:layout_marginEnd="16.0dp"
                            OptimizaCorte:cardCornerRadius="16.0dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@id/linear3"
                              android:layout_width="fill_parent"
                              android:layout_height="fill_parent">
          <TextView android:textSize="14.0sp"
                    android:textColor="@color/cutter_colorPrimary"
                    android:id="@id/textView8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
                    android:text="@string/card_side_damage"
                    OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                    OptimizaCorte:layout_constraintStart_toStartOf="parent"
                    OptimizaCorte:layout_constraintTop_toTopOf="parent" />
          <com.google.android.material.textfield.TextInputLayout android:id="@id/textInputLayout2"
                                android:layout_width="100.0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8.0dp"
                                android:layout_marginBottom="8.0dp"
                                android:hint="@string/damage_left"
                                android:inputType="numberDecimal"
                                android:textAlignment="center"
                                OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
                                OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                                OptimizaCorte:layout_constraintHorizontal_bias="0.186"
                                OptimizaCorte:layout_constraintStart_toStartOf="parent"
                                OptimizaCorte:layout_constraintTop_toBottomOf="@id/textView8"
                                OptimizaCorte:layout_constraintVertical_bias="0.0">
            <com.google.android.material.textfield.TextInputEditText android:id="@id/ed_despuntei"
                                  android:nextFocusDown="@id/ed_despunted"
                                  android:layout_width="fill_parent"
                                  android:layout_height="fill_parent"
                                  android:text="10"
                                  android:inputType="numberDecimal"
                                  android:imeOptions="flagForceAscii"
                                  android:textAlignment="center" />
          </com.google.android.material.textfield.TextInputLayout>
          <com.google.android.material.textfield.TextInputLayout android:layout_width="100.0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8.0dp"
                                android:layout_marginBottom="8.0dp"
                                android:hint="@string/damage_right"
                                android:inputType="numberDecimal"
                                android:textAlignment="center"
                                OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
                                OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                                OptimizaCorte:layout_constraintHorizontal_bias="0.82"
                                OptimizaCorte:layout_constraintStart_toStartOf="parent"
                                OptimizaCorte:layout_constraintTop_toBottomOf="@id/textView8"
                                OptimizaCorte:layout_constraintVertical_bias="0.0">
            <com.google.android.material.textfield.TextInputEditText android:id="@id/ed_despunted"
                                  android:nextFocusDown="@id/ed_disco"
                                  android:layout_width="fill_parent"
                                  android:layout_height="fill_parent"
                                  android:text="10"
                                  android:inputType="numberDecimal"
                                  android:imeOptions="flagForceAscii"
                                  android:textAlignment="center" />
          </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
      </androidx.cardview.widget.CardView>
      <androidx.cardview.widget.CardView android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16.0dp"
                            android:layout_marginStart="16.0dp"
                            android:layout_marginEnd="16.0dp"
                            OptimizaCorte:cardCornerRadius="16.0dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="fill_parent"
                              android:layout_height="fill_parent">
          <TextView android:textSize="14.0sp"
                    android:textColor="@color/cutter_colorPrimary"
                    android:id="@id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
                    android:text="@string/card_disc_settings"
                    OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                    OptimizaCorte:layout_constraintStart_toStartOf="parent"
                    OptimizaCorte:layout_constraintTop_toTopOf="parent" />
          <com.google.android.material.textfield.TextInputLayout android:id="@id/textInputLayout3"
                                android:layout_width="100.0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8.0dp"
                                android:layout_marginBottom="8.0dp"
                                android:hint="@string/disc"
                                android:inputType="numberDecimal"
                                android:textAlignment="center"
                                OptimizaCorte:layout_constraintBottom_toTopOf="@id/switch_x2"
                                OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                                OptimizaCorte:layout_constraintHorizontal_bias="0.186"
                                OptimizaCorte:layout_constraintStart_toStartOf="parent"
                                OptimizaCorte:layout_constraintTop_toBottomOf="@id/textView7">
            <com.google.android.material.textfield.TextInputEditText android:id="@id/ed_disco"
