                    OptimizaCorte:layout_constraintStart_toStartOf="parent"
                    OptimizaCorte:layout_constraintTop_toTopOf="parent" />
          <Spinner android:id="@id/spinner"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="8.0dp"
                   android:layout_marginBottom="8.0dp"
                   android:layout_alignTop="@id/spinner2"
                   android:layout_marginStart="16.0dp"
                   android:layout_alignParentStart="true"
                   OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
                   OptimizaCorte:layout_constraintStart_toStartOf="parent"
                   OptimizaCorte:layout_constraintTop_toBottomOf="@id/textView6" />
          <Spinner android:id="@id/spinner2"
