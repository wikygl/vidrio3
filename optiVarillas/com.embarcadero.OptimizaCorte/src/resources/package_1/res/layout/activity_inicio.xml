              android:focusableInTouchMode="true"
              android:layout_width="fill_parent"
              android:layout_height="0.0dp"
              android:fadeScrollbars="false"
              OptimizaCorte:layout_constraintBottom_toTopOf="@id/linear7"
              OptimizaCorte:layout_constraintEnd_toEndOf="parent"
              OptimizaCorte:layout_constraintStart_toStartOf="parent"
