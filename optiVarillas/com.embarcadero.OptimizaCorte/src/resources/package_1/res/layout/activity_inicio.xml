                                  android:layout_width="fill_parent"
                                  android:layout_height="fill_parent"
                                  android:text="4"
                                  android:inputType="numberDecimal"
                                  android:imeOptions="flagForceAscii"
                                  android:textAlignment="center" />
          </com.google.android.material.textfield.TextInputLayout>
          <com.google.android.material.textfield.TextInputLayout android:id="@id/textInputLayout4"
                                android:layout_width="100.0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8.0dp"
                                android:layout_marginBottom="8.0dp"
                                android:hint="@string/tilt"
                                android:inputType="number"
                                android:textAlignment="center"
                                OptimizaCorte:layout_constraintBottom_toTopOf="@id/switch_x2"
                                OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                                OptimizaCorte:layout_constraintHorizontal_bias="0.82"
                                OptimizaCorte:layout_constraintStart_toStartOf="parent"
                                OptimizaCorte:layout_constraintTop_toBottomOf="@id/textView7">
            <com.google.android.material.textfield.TextInputEditText android:id="@id/ed_disco_tilt"
                                  android:nextFocusDown="@id/ed_despuntei"
                                  android:layout_width="fill_parent"
                                  android:layout_height="fill_parent"
                                  android:text="90"
                                  android:inputType="number"
                                  android:imeOptions="flagForceAscii"
                                  android:textAlignment="center" />
          </com.google.android.material.textfield.TextInputLayout>
          <androidx.appcompat.widget.SwitchCompat android:textSize="12.0sp"
                                android:id="@id/switch_x2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8.0dp"
                                android:checked="true"
                                android:text="@string/check_two_discs"
                                android:switchPadding="16.0dp"
                                OptimizaCorte:layout_constraintBottom_toTopOf="@id/textView3"
                                OptimizaCorte:layout_constraintStart_toStartOf="@id/textInputLayout3" />
          <TextView android:textSize="11.0sp"
                    android:id="@id/textView3"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8.0dp"
                    android:layout_marginRight="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:text="@string/tilt_info"
                    android:textAlignment="center"
                    OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
                    OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                    OptimizaCorte:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
      </androidx.cardview.widget.CardView>
      <androidx.cardview.widget.CardView android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16.0dp"
                            android:layout_marginBottom="8.0dp"
                            android:layout_marginStart="16.0dp"
                            android:layout_marginEnd="16.0dp"
                            OptimizaCorte:cardCornerRadius="16.0dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="fill_parent"
                              android:layout_height="fill_parent">
          <TextView android:textSize="14.0sp"
                    android:textColor="@color/cutter_colorPrimary"
                    android:id="@id/textView9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dp"
