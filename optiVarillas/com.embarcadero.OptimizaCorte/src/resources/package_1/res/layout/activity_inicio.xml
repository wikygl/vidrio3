            android:layout_width="fill_parent"
            android:layout_height="36.0dp"
            android:layout_marginLeft="8.0dp"
            android:layout_marginTop="8.0dp"
            android:layout_marginRight="8.0dp"
            android:layout_marginBottom="8.0dp"
            android:text="@string/btn_remove_ads"
            OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
            OptimizaCorte:layout_constraintEnd_toEndOf="parent"
            OptimizaCorte:layout_constraintStart_toStartOf="parent"
            style="@style/AppTheme.RoundedCornerMaterialButtonBlue" />
  </androidx.constraintlayout.widget.ConstraintLayout>
  <FrameLayout android:id="@id/adaptative_banner"
               android:layout_width="fill_parent"
               android:layout_height="wrap_content"
               OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
               OptimizaCorte:layout_constraintEnd_toEndOf="parent"
               OptimizaCorte:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>