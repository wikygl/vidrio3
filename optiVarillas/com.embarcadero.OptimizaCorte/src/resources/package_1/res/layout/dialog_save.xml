<?xml version='1.0' encoding='utf-8' ?>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="fill_parent"
                      android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:OptimizaCorte="http://schemas.android.com/apk/res-auto">
  <EditText android:id="@id/ed_save_dialog"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dp"
            android:ems="10"
            android:inputType="textPersonName"
            android:layout_marginStart="16.0dp"
            android:layout_marginEnd="16.0dp"
            OptimizaCorte:layout_constraintEnd_toEndOf="parent"
            OptimizaCorte:layout_constraintStart_toStartOf="parent"
            OptimizaCorte:layout_constraintTop_toTopOf="parent" />
  <CheckBox android:id="@id/check_retales_save_dialog"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dp"
            android:text="@string/check_dialog"
            android:layout_marginStart="16.0dp"
            android:layout_marginEnd="16.0dp"
            OptimizaCorte:layout_constraintEnd_toEndOf="parent"
            OptimizaCorte:layout_constraintStart_toStartOf="parent"
            OptimizaCorte:layout_constraintTop_toBottomOf="@id/ed_save_dialog" />
  <CheckBox android:id="@id/check_config_save_dialog"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dp"
            android:text="@string/check_dialog2"
            android:layout_marginStart="16.0dp"
            android:layout_marginEnd="16.0dp"
            OptimizaCorte:layout_constraintEnd_toEndOf="parent"
            OptimizaCorte:layout_constraintStart_toStartOf="parent"
            OptimizaCorte:layout_constraintTop_toBottomOf="@id/check_retales_save_dialog" />
</androidx.constraintlayout.widget.ConstraintLayout>