<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:id="@id/layout_feedback"
              android:visibility="gone"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <TextView android:textSize="@dimen/text_size_title_2"
            android:textColor="@color/primaryTextColor"
            android:id="@id/dialog_rating_feedback_title"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_default"
            android:layout_marginTop="@dimen/margin_default"
            android:layout_marginRight="@dimen/margin_default" />
  <EditText android:textColor="@color/feedbackTextColor"
            android:textColorHint="@color/hintTextColor"
            android:gravity="center|left|top"
            android:id="@id/dialog_rating_feedback"
            android:background="@drawable/edittext_background"
            android:padding="@dimen/margin_small"
            android:scrollbars="vertical"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/form_height"
            android:layout_marginLeft="@dimen/margin_default"
            android:layout_marginTop="@dimen/margin_default"
            android:layout_marginRight="@dimen/margin_default"
            android:maxLines="10"
            android:lines="8"
            android:minLines="6"
            android:inputType="textCapSentences|textMultiLine" />
  <LinearLayout android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_default">
    <TextView android:textSize="@dimen/text_size_button"
              android:textColor="@color/primaryTextColor"
              android:gravity="center"
              android:id="@id/dialog_rating_button_feedback_cancel"
              android:background="?attr/selectableItemBackground"
              android:padding="@dimen/margin_default"
              android:focusable="true"
              android:clickable="true"
              android:layout_width="0.0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1.0" />
    <TextView android:textSize="@dimen/text_size_button"
              android:textColor="@color/colorAccent"
              android:gravity="center"
              android:id="@id/dialog_rating_button_feedback_submit"
              android:background="?attr/selectableItemBackground"
              android:padding="@dimen/margin_default"
              android:focusable="true"
              android:clickable="true"
              android:layout_width="0.0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1.0" />
  </LinearLayout>
</LinearLayout>