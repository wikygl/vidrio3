<?xml version='1.0' encoding='utf-8' ?>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="fill_parent"
                      android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:OptimizaCorte="http://schemas.android.com/apk/res-auto">
  <com.google.android.material.tabs.TabLayout android:layout_gravity="top"
                        android:id="@id/tabs"
                        android:background="@color/cutter_colorPrimaryDark"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        OptimizaCorte:layout_constraintEnd_toEndOf="parent"
                        OptimizaCorte:layout_constraintStart_toStartOf="parent"
                        OptimizaCorte:layout_constraintTop_toTopOf="parent"
                        OptimizaCorte:tabIndicatorColor="@color/white"
                        OptimizaCorte:tabSelectedTextColor="@color/white"
                        OptimizaCorte:tabTextAppearance="@style/TextAppearance.AppCompat"
                        OptimizaCorte:tabTextColor="#acacac" />
  <androidx.viewpager2.widget.ViewPager2 android:id="@id/pager"
                        android:layout_width="fill_parent"
                        android:layout_height="0.0dp"
                        OptimizaCorte:layout_constraintBottom_toBottomOf="parent"
                        OptimizaCorte:layout_constraintTop_toBottomOf="@id/tabs" />
</androidx.constraintlayout.widget.ConstraintLayout>